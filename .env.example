# ─── Gemini AI ───────────────────────────────────────────────────────────────
# Required. Get it from https://aistudio.google.com/app/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# ─── App URL ─────────────────────────────────────────────────────────────────
# The public URL where the app is hosted (no trailing slash).
# Render sets this automatically via RENDER_EXTERNAL_URL.
# For Vercel, set it to your *.vercel.app domain.
APP_URL="http://localhost:3000"

# ─── Firebase ────────────────────────────────────────────────────────────────
# Copy these values from Firebase Console → Project Settings → Your Apps → Web App
# All VITE_ vars are embedded into the frontend bundle at build time (public, safe).
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT_ID.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_PROJECT_ID.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"

# Optional: only needed if you use a non-default Firestore database.
# Leave blank to use "(default)" database.
VITE_FIREBASE_DATABASE_ID=""
